# OpenShell Backend Configuration
# Copy to .env and fill in values

# Application
APP_NAME=OpenShell
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite+aiosqlite:///./openshell.db

# Security
SECRET_KEY=change-me-in-production-use-secure-random-32-bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Keycloak / OIDC
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=openshell
KEYCLOAK_CLIENT_ID=openshell-backend
KEYCLOAK_CLIENT_SECRET=
OIDC_DISCOVERY_URL=http://localhost:8080/realms/openshell/.well-known/openid-configuration
OIDC_ISSUER=http://localhost:8080/realms/openshell
OIDC_AUDIENCE=openshell-backend

# Frontend (for CORS)
FRONTEND_URL=http://localhost:5173

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=openshell-backend
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp

# LLM (optional, for agent features)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Demo mode (local only, refuses in production)
DEMO_MODE=true